<Window x:Class="UACMockup.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ID Verification"
        Width="456"
        MinHeight="350"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Topmost="True"
        ResizeMode="NoResize" KeyDown="Window_KeyDown" Focusable="True" Loaded="Window_Loaded">

    <Border
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border
                Grid.Row="0"
                Padding="18,12,0,12"
                Background="{DynamicResource TopBarBackgroundBrush}"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Small"
                        FontSize="12"
                        Foreground="{DynamicResource TitleForegroundBrush}"
                        Text="ID Verification"/>

                    <Border
                        Width="32"
                        Height="32"
                        Margin="0,-12,0,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        CornerRadius="0,8,0,0">
                        <Button
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click"
                            Content="✕"
                            Foreground="{DynamicResource TitleForegroundBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="0,8,0,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource CloseButtonPressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="22" Background="Transparent">
                <TextBlock
                    FontSize="18"
                    FontWeight="600"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="Please scan your ID"
                    Margin="0,0,0,8"/>

                <Border x:Name="CameraBorder" Background="{DynamicResource TopBarBackgroundBrush}" CornerRadius="4">
                    <Grid>
                        <Image x:Name="CameraImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,5" VerticalAlignment="Center">
                    <Viewbox Width="28" Height="28" Margin="0,0,8,0">
                        <Canvas Width="16.933333" Height="15.345835">
