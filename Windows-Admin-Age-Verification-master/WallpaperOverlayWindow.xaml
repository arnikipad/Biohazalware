<Window x:Class="UACMockup.WallpaperOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Topmost="False"
        ShowActivated="False"
        Focusable="False">
    <Grid>
        <Image x:Name="WallpaperImage" Stretch="UniformToFill" />
        <Rectangle Fill="Black" Opacity="0.45"/>
    </Grid>
</Window>