<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#ffffff</Color>
    <Color x:Key="WindowBorderColor">#c4c4c4</Color>
    <Color x:Key="TitleForegroundColor">#000000</Color>
    <Color x:Key="TitleSecondaryForegroundColor">#FF333333</Color>
    <Color x:Key="ButtonBackgroundColor">#FF2D2D2D</Color>
    <Color x:Key="ButtonForegroundColor">#000000</Color>
    <Color x:Key="AccentColor">#005fb8</Color>
    <Color x:Key="AccentHoverColor">#003e92</Color>
    <Color x:Key="PrimaryTextColor">#000000</Color>
    <Color x:Key="AccentButtonForegroundColor">#ffffff</Color>
    <Color x:Key="TransparentButtonTextColor">#003e92</Color>
    <Color x:Key="TransparentButtonBackgroundHoverColor">#f5f5f5</Color>
    <Color x:Key="TransparentButtonBackgroundPressColor">#fafafa</Color>
    <Color x:Key="VerificationMarkColor">#2dbf2d</Color>
    <Color x:Key="VerificationMarkCheckmarkColor">#ffffff</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorderColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderBrushColor}" />
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="{StaticResource TitleForegroundColor}" />
    <SolidColorBrush x:Key="TitleSecondaryForegroundBrush" Color="{StaticResource TitleSecondaryForegroundColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForegroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="{StaticResource AccentButtonForegroundColor}" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TransparentButtonTextBrush" Color="{StaticResource TransparentButtonTextColor}" />
    <SolidColorBrush x:Key="TransparentButtonBackgroundHoverBrush" Color="{StaticResource TransparentButtonBackgroundHoverColor}" />
    <SolidColorBrush x:Key="TransparentButtonBackgroundPressBrush" Color="{StaticResource TransparentButtonBackgroundPressColor}" />
    <SolidColorBrush x:Key="VerificationMarkBrush" Color="{StaticResource VerificationMarkColor}" />
    <SolidColorBrush x:Key="VerificationMarkCheckmarkBrush" Color="{StaticResource VerificationMarkCheckmarkColor}" />
    <!-- Extracted hardcoded colors from MainWindow.xaml for theming -->
    <Color x:Key="TopBarBackgroundColor">#e7e7e7</Color>
    <Color x:Key="DialogBackgroundColor">#f3f3f3</Color>
    <Color x:Key="YesButtonRestColor">#fbfbfb</Color>
    <Color x:Key="YesButtonHoverColor">#f6f6f6</Color>
    <Color x:Key="YesButtonPressedColor">#f5f5f5</Color>
    <Color x:Key="YesButtonBorderColor">#e5e5e5</Color>
    <Color x:Key="YesButtonBorderHoverColor">#e5e5e5</Color>
    <Color x:Key="YesButtonBorderPressedColor">#e5e5e5</Color>
    <Color x:Key="NoButtonPressedColor">#0078d4</Color>
    <Color x:Key="NoButtonPressedForegroundColor">#a9d1f0</Color>
    <Color x:Key="CloseButtonHoverColor">#E81123</Color>
    <Color x:Key="CloseButtonPressedColor">#e76671</Color>
    <Color x:Key="PressedTextColor">#6d6d6d</Color>
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="{StaticResource TopBarBackgroundColor}" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="{StaticResource DialogBackgroundColor}" />
    <SolidColorBrush x:Key="YesButtonRestBrush" Color="{StaticResource YesButtonRestColor}" />
    <SolidColorBrush x:Key="YesButtonHoverBrush" Color="{StaticResource YesButtonHoverColor}" />
    <SolidColorBrush x:Key="YesButtonPressedBrush" Color="{StaticResource YesButtonPressedColor}" />
    <SolidColorBrush x:Key="YesButtonBorderBrush" Color="{StaticResource YesButtonBorderColor}" />
    <SolidColorBrush x:Key="YesButtonBorderHoverBrush" Color="{StaticResource YesButtonBorderHoverColor}" />
    <SolidColorBrush x:Key="YesButtonBorderPressedBrush" Color="{StaticResource YesButtonBorderPressedColor}" />
    <SolidColorBrush x:Key="NoButtonPressedBrush" Color="{StaticResource NoButtonPressedColor}" />
    <SolidColorBrush x:Key="NoButtonPressedForegroundBrush" Color="{StaticResource NoButtonPressedForegroundColor}" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="{StaticResource CloseButtonHoverColor}" />
    <SolidColorBrush x:Key="CloseButtonPressedBrush" Color="{StaticResource CloseButtonPressedColor}" />
    <SolidColorBrush x:Key="PressedTextBrush" Color="{StaticResource PressedTextColor}" />

        <!-- Yes Button Disabled State -->
    <Color x:Key="YesButtonDisabledColor">#FFE0E0E0</Color>
    <Color x:Key="YesButtonDisabledBorderColor">#FFCCCCCC</Color>
    <Color x:Key="YesButtonDisabledForegroundColor">#FFAAAAAA</Color>
    <SolidColorBrush x:Key="YesButtonDisabledBrush" Color="{StaticResource YesButtonDisabledColor}"/>
    <SolidColorBrush x:Key="YesButtonDisabledBorderBrush" Color="{StaticResource YesButtonDisabledBorderColor}"/>
    <SolidColorBrush x:Key="YesButtonDisabledForegroundBrush" Color="{StaticResource YesButtonDisabledForegroundColor}"/>
</ResourceDictionary>