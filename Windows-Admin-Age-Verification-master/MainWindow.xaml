<Window
    x:Class="UACMockup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="User Account Control"
    Width="456"
    MinHeight="350"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI Variable"
    FontSize="14"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Topmost="True"
    ResizeMode="NoResize" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="WindowsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border x:Name="Box" Width="21" Height="21" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource TitleForegroundBrush}" Background="{DynamicResource WindowBackgroundBrush}"/>
                                <Path x:Name="CheckMark" Data="M6,6 L9,9 L15,3" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" ContentSource="Content"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource AccentButtonForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource TopBarBackgroundBrush}"/>
                            </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentButtonHoverBrush}"/>
                                    <Setter TargetName="Box" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource NoButtonPressedForegroundBrush}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsPressed" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource NoButtonPressedBrush}"/>
                                    <Setter TargetName="Box" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource NoButtonPressedForegroundBrush}"/>
                                </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="22,15,0,0"
                Background="{DynamicResource TopBarBackgroundBrush}"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock
                        Margin="0,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Small"
                        FontSize="12"
                        Foreground="{DynamicResource TitleForegroundBrush}"
                        Text="User Account Control"/>
                    <Border
                        Width="32"
                        Height="32"
                        Margin="0,-16,0,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        CornerRadius="0,8,0,0">
                        <Button
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click"
                            Content="✕"
                            Foreground="{DynamicResource TitleForegroundBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="border"
                                        Background="Transparent"
                                        CornerRadius="0,8,0,0">
                                        <ContentPresenter x:Name="contentPresenter"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="{DynamicResource CloseButtonHoverBrush}"/>
                                            <Setter TargetName="contentPresenter"
                                                    Property="TextElement.Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                Value="True">
                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="{DynamicResource CloseButtonPressedBrush}"/>
                                            <Setter TargetName="contentPresenter"
                                                    Property="TextElement.Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="22,15,25,0"
                Background="{DynamicResource TopBarBackgroundBrush}">
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="20"
                    FontWeight="600"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="Do you want to allow this app to make changes to your device?"
                    TextAlignment="Left"
                    TextWrapping="Wrap"/>
            </Border>

            <StackPanel
                Grid.Row="2"
                Margin="22,26,25,0"
                Background="Transparent"
                ClipToBounds="False">
                <StackPanel Margin="0,0,0,27" Orientation="Horizontal">
                    <Image
                        Width="28"
                        Height="28"
                        Margin="5,0,20,0"
                        VerticalAlignment="Center"
                        Source="{Binding TerminalIcon.Icon}"/>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="600"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="Terminal"/>
                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,0"
                        Foreground="{DynamicResource PrimaryTextBrush}">
                        Verified publisher: Microsoft Corporation
                        <LineBreak/>
                        File origin: Hard drive on this computer
                    </TextBlock>
                    <StackPanel x:Name="DetailsPanel"
                            Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,0"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            FontSize="14"
                            Text="Program location: &quot;C:\Program Files\WindowsApps\Microsoft.WindowsTerminal_1.23.20211.0_x64__8wekyb3d8bbwe\WindowsTerminal.exe&quot;"
                            TextWrapping="Wrap"/>
                        <Canvas Margin="0,0,0,40"
                                ClipToBounds="False">
                            <Canvas.RenderTransform>
                                    <TranslateTransform X="-5"/>
                                </Canvas.RenderTransform>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Foreground="{DynamicResource TransparentButtonTextBrush}"
                                Content="Change when these notifications appear">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Padding="11,6">
                                            <ContentPresenter x:Name="contentPresenter"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="0"
                                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                    Value="True">
                                                <Setter TargetName="border"
                                                        Property="Background"
                                                        Value="{DynamicResource TransparentButtonBackgroundHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed"
                                                    Value="True">
                                                <Setter TargetName="border"
                                                        Property="Background"
                                                        Value="{DynamicResource TransparentButtonBackgroundPressBrush}"/>
                                                <Setter TargetName="contentPresenter"
                                                        Property="TextElement.Foreground"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.HorizontalAlignment>
                                    Left
                                </Button.HorizontalAlignment>
                            </Button>
                        </Canvas>
                    </StackPanel>
                </StackPanel>

                <!-- 52 -->
                <Canvas Margin="0,25,0,35"
                        ClipToBounds="False">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="-10"/>
                    </Canvas.RenderTransform>
                    <Button
                        x:Name="ShowDetailsButton"
                        Background="{DynamicResource TransparentButtonBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Foreground="{DynamicResource TransparentButtonTextBrush}"
                        Content="Show more details"
                        Click="ShowDetailsButton_Click"
                        HorizontalAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="3"
                                        Padding="11,6">
                                    <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="0"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                            Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{DynamicResource TransparentButtonBackgroundHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                            Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{DynamicResource TransparentButtonBackgroundPressBrush}"/>
                                        <Setter TargetName="contentPresenter"
                                                Property="TextElement.Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Canvas>

                <Border
                    Margin="0,20,0,0"
                    Padding="0"
                    MinHeight="120"
                    Background="{DynamicResource TopBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,-6,0"
                                Padding="12,0,0,0"
                                Background="{DynamicResource TopBarBackgroundBrush}"
                                CornerRadius="3"
                                VerticalAlignment="Stretch">
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="100" Height="56.6" ClipToBounds="False">
                                    <Rectangle Width="90" Height="56.6" RadiusX="6" RadiusY="6"
                                               Canvas.Left="5"
                                               Fill="{DynamicResource WindowBackgroundBrush}"
                                               Stroke="{DynamicResource TitleForegroundBrush}"
                                               StrokeThickness="1"/>

                                    <Rectangle Width="20.28" Height="26" RadiusX="3" RadiusY="3"
                                               Stroke="{DynamicResource TitleForegroundBrush}"
                                               Canvas.Left="13" Canvas.Top="8"/>

                                    <Ellipse Canvas.Left="17" Canvas.Top="14" Width="12" Height="12" Stroke="{DynamicResource TitleForegroundBrush}"/>

                                    <Path Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="1">
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathGeometry.Figures>
                                                    <PathFigureCollection>
                                                        <PathFigure StartPoint="15.5,33">
                                                            <PathFigure.Segments>
                                                                <PathSegmentCollection>
                                                                    <ArcSegment Size="6, 6"
                                                                    IsLargeArc="True"
                                                                    SweepDirection="Clockwise"
                                                                    Point="30.5,33" />
                                                                </PathSegmentCollection>
                                                            </PathFigure.Segments>
                                                        </PathFigure>
                                                    </PathFigureCollection>
                                                </PathGeometry.Figures>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>

                                    <Line X1="41.28" Y1="9" X2="87" Y2="9" Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="1"/>

                                    <Line X1="41.28" Y1="17" X2="75" Y2="17" Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="1"/>

                                    <Line X1="41.28" Y1="25" X2="87" Y2="25" Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="1"/>

                                    <Line X1="41.28" Y1="33" X2="75" Y2="33" Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="1"/>

                                    <Line X1="13" Y1="40" X2="87" Y2="40" Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="1"/>

                                    <Line X1="13" Y1="48" X2="87" Y2="48" Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="1"/>

                                    <Canvas x:Name="VerificationMark" Canvas.Left="70" Canvas.Top="30" Visibility="Collapsed">
                                        <Ellipse Width="30" Height="30" Fill="{DynamicResource VerificationMarkBrush}"/>
                                        <!-- M6,6 L9,9 L15,3 -->
                                        <!-- Data="M9,17 L14,23 L22,9" -->
                                        <Path Stroke="{DynamicResource VerificationMarkCheckmarkBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             Data="M9,16 L13,20 L21,11" />
                                    </Canvas>

                                    <Line x:Name="ScanLine" X1="50" Y1="-10" X2="50" Y2="-10" Stroke="{DynamicResource TitleForegroundBrush}" StrokeThickness="2" Opacity="0"/>
                                    <Canvas.Resources>
                                        <Storyboard x:Key="ScanLineStoryboard" RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="X1">
                                                <LinearDoubleKeyFrame Value="50" KeyTime="0:0:0"/>
                                                <LinearDoubleKeyFrame Value="50" KeyTime="0:0:1"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.3"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.3"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.5"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.6"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:3.5"/>
                                                <LinearDoubleKeyFrame Value="50" KeyTime="0:0:3.8"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="X2">
                                                <LinearDoubleKeyFrame Value="50" KeyTime="0:0:0"/>
                                                <LinearDoubleKeyFrame Value="50" KeyTime="0:0:1"/>
                                                <LinearDoubleKeyFrame Value="100" KeyTime="0:0:1.3"/>
                                                <LinearDoubleKeyFrame Value="100" KeyTime="0:0:2.3"/>
                                                <LinearDoubleKeyFrame Value="100" KeyTime="0:0:2.4"/>
                                                <LinearDoubleKeyFrame Value="100" KeyTime="0:0:2.5"/>
                                                <LinearDoubleKeyFrame Value="100" KeyTime="0:0:2.6"/>
                                                <LinearDoubleKeyFrame Value="100" KeyTime="0:0:3.5"/>
                                                <LinearDoubleKeyFrame Value="50" KeyTime="0:0:3.8"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Y1">
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:0"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:1"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:1.3"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.3"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.4"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.5"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.6"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:3.6"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:3.9"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Y2">
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:0"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:1"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:1.3"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.3"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.4"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.5"/>
                                                <LinearDoubleKeyFrame Value="66.6" KeyTime="0:0:2.6"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:3.6"/>
                                                <LinearDoubleKeyFrame Value="-10" KeyTime="0:0:3.9"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                                                <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:1"/>
                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.05"/>
                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:2.4"/>
                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:2.5"/>
                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:2.6"/>
                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:3.6"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:3.9"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </Canvas.Resources>
                                    <Canvas.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource ScanLineStoryboard}"/>
                                        </EventTrigger>
                                    </Canvas.Triggers>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border Grid.Column="1" Margin="12,0,12,0" Padding="12" Background="Transparent">
                            <StackPanel>
                                <TextBlock
                                x:Name="VerificationStatusText"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="Age Verification Required"/>
                                <TextBlock
                                    x:Name="VerificationInstructionsText"
                                    Margin="0,5,0,10"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="This action requires you to be 18+. Please scan your ID."
                                    TextWrapping="Wrap"/>

                                <StackPanel x:Name="RememberPanel" Visibility="Collapsed" Margin="0,6,0,6">
                                     <CheckBox x:Name="RememberCheckBox"
                                             Style="{StaticResource WindowsCheckBoxStyle}"
                                             Content="Remember me for 5 minutes"
                                             VerticalAlignment="Center"/>
                                </StackPanel>

                                <Canvas Margin="0,0,0,25" ClipToBounds="False" x:Name="ScanButtonCanvas">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="-12"/>
                                </Canvas.RenderTransform>
                                <Button
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Click="StartScan_Click"
                                    Background="{DynamicResource TransparentButtonBackgroundBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Foreground="{DynamicResource TransparentButtonTextBrush}"
                                    Content="Start ID Scan">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="11,6">
                                                <ContentPresenter x:Name="contentPresenter"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="0"
                                                        TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                        Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Background"
                                                            Value="{DynamicResource TransparentButtonBackgroundHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed"
                                                        Value="True">
                                                    <Setter TargetName="border"
                                                            Property="Background"
                                                            Value="{DynamicResource TransparentButtonBackgroundPressBrush}"/>
                                                    <Setter TargetName="contentPresenter"
                                                            Property="TextElement.Foreground"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                </Canvas>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    FontSize="11"
                    TextWrapping="Wrap">
                    <Run Text="Verification handled by Microsoft Entra ID (v.4.2.1-canary). Data is encrypted via TPM 2.0 before it leaves the device. "/>
                    <Run Text="Learn more" Foreground="{DynamicResource TransparentButtonTextBrush}"/>
                </TextBlock>
            </StackPanel>
            <Border Grid.Row="3"
                    Margin="0,25,0,0"
                    Padding="20"
                    Background="{DynamicResource DialogBackgroundBrush}"
                    CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="YesButton"
                        Height="32"
                        Margin="5"
                        Background="{DynamicResource YesButtonRestBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource YesButtonBorderBrush}"
                        Content="Yes"
                        Foreground="{DynamicResource ButtonForegroundBrush}"
                        IsEnabled="False"
                        Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource YesButtonBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource YesButtonDisabledBrush}"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource YesButtonDisabledBorderBrush}"/>
                                        <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource YesButtonDisabledForegroundBrush}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsPressed" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource YesButtonPressedBrush}"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource YesButtonBorderPressedBrush}"/>
                                        <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource PressedTextBrush}"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource YesButtonHoverBrush}"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource YesButtonBorderHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource YesButtonPressedBrush}"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource YesButtonBorderPressedBrush}"/>
                                        <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource PressedTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Height="32"
                        Margin="5"
                        Background="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        Content="No"
                        Foreground="{DynamicResource AccentButtonForegroundBrush}"
                        Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                            Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{DynamicResource AccentButtonHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                            Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{DynamicResource NoButtonPressedBrush}"/>
                                        <Setter TargetName="contentPresenter"
                                                Property="TextElement.Foreground"
                                                Value="{DynamicResource NoButtonPressedForegroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
